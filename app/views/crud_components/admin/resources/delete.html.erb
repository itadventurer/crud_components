<% title = t('crud_components.admin.delete.title', model: @model.model_name.human,
              default: 'Delete this %{model}?') %>
<% content_for :title, title %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to @entry.label, admin_index_path(@entry) %></li>
    <li class="breadcrumb-item"><%= link_to crud_label(@record), url_for(@record) %></li>
    <li class="breadcrumb-item active" aria-current="page"><%= t('crud_components.actions.destroy', default: 'Delete') %></li>
  </ol>
</nav>

<div class="card border-danger">
  <div class="card-body">
    <h1 class="h5 mb-3"><%= title %></h1>
    <p class="mb-3"><strong><%= crud_label(@record) %></strong></p>

    <% blockers = @dependents.blockers %>
    <% if blockers.any? %>
      <div class="alert alert-warning">
        <p class="mb-1"><%= t('crud_components.admin.delete.blocked', default: 'This cannot be deleted while it still has:') %></p>
        <ul class="mb-0">
          <% blockers.each do |item| %>
            <li>
              <%= item.count %> <%= item.human_name %>
              <%= render 'crud_components/admin/resources/dependent_records', owner: @record, item: item %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% goes = @dependents.items.select { |item| item.destroys? } %>
    <% nullified = @dependents.items.select(&:nullifies?) %>

    <% if goes.any? %>
      <p class="mb-1"><%= t('crud_components.admin.delete.also_deleted', default: 'These go with it:') %></p>
      <ul>
        <% goes.each do |item| %>
          <li>
            <strong><%= number_with_delimiter(item.count) %></strong> <%= item.human_name %>
            <% if item.cascades %>
              <span class="text-muted"><%= t('crud_components.admin.delete.cascades',
                                             default: '(and whatever depends on those)') %></span>
            <% end %>
            <%= render 'crud_components/admin/resources/dependent_records', owner: @record, item: item %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if nullified.any? %>
      <p class="mb-1"><%= t('crud_components.admin.delete.kept', default: 'These stay, but lose the reference:') %></p>
      <ul>
        <% nullified.each do |item| %>
          <li>
            <strong><%= number_with_delimiter(item.count) %></strong> <%= item.human_name %>
            <%= render 'crud_components/admin/resources/dependent_records', owner: @record, item: item %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if goes.empty? && nullified.empty? && blockers.empty? %>
      <p class="text-muted"><%= t('crud_components.admin.delete.nothing_else', default: 'Nothing else depends on it.') %></p>
    <% end %>

    <div class="d-flex gap-2 mt-4">
      <%= button_to t('crud_components.actions.destroy', default: 'Delete'), url_for(@record),
                    method: :delete, class: 'btn btn-danger', disabled: blockers.any? %>
      <%= link_to t('crud_components.admin.delete.cancel', default: 'Cancel'), url_for(@record),
                  class: 'btn btn-outline-secondary' %>
    </div>
  </div>
</div>
