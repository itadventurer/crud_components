<% content_for :title, @entry.label %>

<h1 class="h4 mb-3"><%= admin_icon(@entry.icon) %> <%= @entry.label %></h1>

<div class="card">
  <div class="card-body">
    <%= crud_collection @records, query: @query, fieldset: @entry.fieldset, picker: true,
                        extra_actions: [admin_show_in_app_action] %>
  </div>
</div>
