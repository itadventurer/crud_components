<%# Locals: field, query, form_id, compact, autosubmit, param_name, css
    A text filter — free text over the target's label, or its identify_by
    value — that the optional crud-combobox controller turns into a combobox:
    it asks this same page for suggestions and submits the identify_by value
    of the one picked. Without the controller it is the plain text filter. %>
<% value = query.value(field.name.to_s) %>
<% choices_param = query.param_name(CrudComponents::Query::CHOICES_PARAM) %>
<% term_param = query.param_name(CrudComponents::Query::TERM_PARAM) %>
<% kept = request.query_parameters.except(choices_param, term_param) %>
<% source = form_id || CrudComponents::Presenters::Filter::CHOICES_SOURCE %>
<%= tag.div class: css.combobox,
            data: { controller: 'crud-combobox',
                    crud_combobox_url_value: kept.any? ? "#{request.path}?#{kept.to_query}" : request.path,
                    crud_combobox_field_value: field.name,
                    crud_combobox_param_value: param_name,
                    crud_combobox_choices_param_value: choices_param,
                    crud_combobox_term_param_value: term_param,
                    crud_combobox_source_value: source,
                    crud_combobox_label_value: field.filter_value_label(query, value),
                    crud_combobox_autosubmit_value: autosubmit,
                    crud_combobox_option_class: css.combobox_option,
                    crud_combobox_active_class: css.combobox_option_active } do %>
  <%= tag.input type: 'search', name: param_name, value: value,
                class: compact ? css.input_sm : css.input, form: form_id,
                placeholder: (field.human_name if compact), autocomplete: 'off',
                aria: { label: field.human_name },
                data: { crud_combobox_target: 'input' } %>
  <%= tag.ul id: "#{source}_#{param_name}_choices", role: 'listbox', class: css.combobox_menu, hidden: true,
             aria: { label: field.human_name }, data: { crud_combobox_target: 'listbox' } %>
<% end %>
