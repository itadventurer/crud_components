<%# Locals: field, query, form_id, compact, autosubmit, param_name, css
    Present / absent control for an attachment column (an EXISTS / NOT EXISTS,
    see Fields::AttachmentField) or a secret (set / not set, see Fields::SecretField). %>
<% present, absent = if field.secret?
                       [t('crud_components.secret.set', default: 'Set'),
                        t('crud_components.secret.not_set', default: 'Not set')]
                     else
                       [t('crud_components.filter.present', default: 'Present'),
                        t('crud_components.filter.absent', default: 'Absent')]
                     end %>
<% choices = [
     [t('crud_components.filter.any', default: '–'), ''],
     [present, CrudComponents::PRESENT_FILTER_VALUE],
     [absent, CrudComponents::ABSENT_FILTER_VALUE]
   ] %>
<%= select_tag param_name,
               options_for_select(choices, query.value(field.name.to_s)),
               class: compact ? css.select_input_sm : css.select_input, form: form_id, id: nil,
               data: (autosubmit ? { action: 'change->crud-filter#submit' } : {}),
               aria: { label: field.human_name } %>
