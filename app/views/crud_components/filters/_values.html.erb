<%# Locals: field, query, form_id, compact, autosubmit, param_name, css
    A multiple select of the values occurring in the list, submitted as
    `param_name[]`. The optional crud-value-filter controller turns it into a
    button with a searchable checkbox popover. Without it the select is the
    control, and it does not submit on change: picking several values takes
    more than one change. %>
<% values = CrudComponents::Presenters::ValueFilter.new(view: self, field: field, query: query,
                                                        form_id: form_id, autosubmit: autosubmit) %>
<%= tag.div class: css.value_filter, data: values.data do %>
  <%= select_tag param_name, options_for_select(values.options, values.selected),
                 multiple: true, form: form_id, id: nil,
                 size: values.options.size.clamp(2, compact ? 4 : 8),
                 class: compact ? css.select_input_sm : css.select_input,
                 aria: { label: field.human_name },
                 data: { crud_value_filter_target: 'select' } %>
<% end %>
