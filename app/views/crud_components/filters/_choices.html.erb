<%# The answer to a value filter's search, rendered by crud_collection /
    crud_filter in place of the list. Locals: matches ([label, value] pairs),
    total (how many choices match in all), param_name (the filter param asked
    about), source (which collection or filter form answers). The
    crud-value-filter controller reads the items; the element is never shown. %>
<%= tag.ul hidden: true, data: { crud_choices: param_name, crud_choices_source: source, crud_choices_total: total } do %>
  <% matches.each do |label, value| %>
    <%= tag.li label, data: { value: value } %>
  <% end %>
<% end %>
