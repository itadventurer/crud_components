<%# Locals: value (whether a value is stored), record, field, surface, cell_context.
    A secret is never shown, only whether there is one — marked like a boolean. %>
<% css = CrudComponents.config.css %>
<% label = value ? t('crud_components.secret.set', default: 'Set') : t('crud_components.secret.not_set', default: 'Not set') %>
<% icon = tag.span(value ? '✓' : '✗', class: value ? css.boolean_true : css.boolean_false, title: label, aria: { label: label }) %>
<%- if cell_context&.filterable?(field) -%>
  <%= link_to icon, cell_context.filter_url(field, field.filter_value(value)), class: css.filter_link,
              data: { turbo_action: 'advance' } %>
<%- else -%>
  <%= icon %>
<%- end -%>
