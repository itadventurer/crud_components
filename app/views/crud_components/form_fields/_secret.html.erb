<%# Form input for a secret (`secret: true`). Locals: f, field, form.
    Starts empty whatever is stored: leaving it empty keeps the stored value,
    the box below clears it. A text column gets a textarea, so a pasted
    multi-line key keeps its line breaks. %>
<% stored = field.stored?(form.record) %>
<% hint = if stored
            t('crud_components.secret.stored', default: 'A value is stored. Leave empty to keep it.')
          else
            t('crud_components.secret.not_stored', default: 'No value stored.')
          end %>
<% input_html = { value: '', autocomplete: 'new-password', spellcheck: false, autocapitalize: 'off',
                  data: { crud_secret: true } } %>
<%= f.input field.name, as: field.multiline? ? :text : :password, hint: hint, required: false,
                        input_html: input_html %>
<% if stored %>
  <%= f.input field.remove_param, as: :boolean, required: false,
                                  label: t('crud_components.secret.remove', default: 'Remove the stored value') %>
<% end %>
