<%# A host-supplied layout for the admin (config.layout = 'host_chrome').
    Route helpers in a layout the engine renders in must go through main_app. %>
<!DOCTYPE html>
<html>
  <head>
    <title>Host chrome</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>
  <body>
    <header id="host-chrome">
      <%= link_to 'Back to the playground', main_app.root_path %>
    </header>
    <main class="container-fluid py-3"><%= yield %></main>
  </body>
</html>
